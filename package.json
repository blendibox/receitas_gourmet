{
  "name": "receitas_gourmet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:eletro": "node scripts/buildLotes.js eletro",
    "merge:eletro": "node scripts/mesclarOutros.js eletro",
    "build-xml-to-json": "node scripts/gerarProdutosJson.js",
    "build-slugs:gerar": "node scripts/gerarSlugIndex.js ",
    "build-slugs:quebrar": " node scripts/quebrarSlugsPorMarca.js",
    "build-sitemap": "npx next-sitemap --config next-sitemap.config.cjs",
    "dev": "next dev --turbopack",
    "prod": "serve out",
    "build": "npm run build-xml-to-json && npm run build-slugs:gerar  && npm run build-slugs:quebrar && npm run categorias && next build && npm run build:eletro && npm run merge:eletro  && npm run build-sitemap && npm run  build:feed",
    "start": "next start",
    "lint": "next lint",
    "build:feed": " node scripts/gerarFeed.js",
    "categorias": "node scripts/gerarCategorias.js"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@microsoft/clarity": "^1.0.0",
    "child_process": "^1.0.2",
    "cross-env": "^10.0.0",
    "fs-extra": "^11.3.1",
    "html-entities": "^2.6.0",
    "next": "^15.4.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sitemap": "^8.0.0",
    "slugify": "^1.6.6",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "next-sitemap": "^4.2.3",
    "tailwindcss": "^4"
  }
}
